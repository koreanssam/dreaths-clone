# DREATHS Clone Environment Variables
# (UI의 API 연동 설정 모달에서도 런타임 저장 및 덮어쓰기가 가능합니다)

# Naver DataLab Shopping Insight API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Coupang Partners Open API
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Upstage Solar Pro 4 API
UPSTAGE_API_KEY=

# OpenAI GPT-6-Luna API
OPENAI_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# Meta Threads Graph API (v1.0)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# SQLite Database Path (default: ./dreaths.db)
DATABASE_PATH=./dreaths.db
